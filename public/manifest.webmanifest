{
  "name": "RoomHisaab — Shared room expenses, made simple",
  "short_name": "RoomHisaab",
  "description": "A simple shared notebook for room expenses. Add a bill once, see who should pay whom, and pay the exact amount with UPI.",
  "start_url": "/room",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F6F6FB",
  "theme_color": "#5046C8",
  "categories": ["finance", "productivity", "lifestyle"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/inbox",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Add a purchase",
      "short_name": "Add",
      "url": "/room/buy",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Pay pending money",
      "short_name": "Pay",
      "url": "/room/payments",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Help & Guide",
      "short_name": "Guide",
      "url": "/room/guide",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Auto Capture",
      "short_name": "Auto",
      "url": "/inbox",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
